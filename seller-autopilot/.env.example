# Server
PORT=3000
NODE_ENV=development

# MongoDB (get free from mongodb.com/atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/seller-autopilot

# JWT Secret (any random string)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long

# Shopify App (from partners.shopify.com)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,write_orders,read_inventory,read_products,write_products
SHOPIFY_REDIRECT_URI=https://your-app.railway.app/auth/shopify/callback

# Gemini AI (free from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Stripe (from stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_stripe_price_id

# App URL
APP_URL=https://your-app.railway.app
FRONTEND_URL=https://remarkable-naiad-9a20e1.netlify.app
